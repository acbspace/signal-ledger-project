# Docker Compose defaults are safe for local development only.
POSTGRES_DB=signalledger
POSTGRES_USER=signalledger
POSTGRES_PASSWORD=signalledger
POSTGRES_PORT=5432
API_PORT=8080
QUANT_PORT=8000
MAX_UPLOAD_BYTES=20971520

# Market data snapshots use yfinance daily bars.
MARKET_DATA_PROVIDER=yfinance

# Set LLM_PROVIDER=anthropic plus an API key to replace the heuristic claim
# extractor with the LLM adapter. Keep real secrets only in .env.
LLM_PROVIDER=disabled
LLM_API_KEY=
LLM_MODEL=claude-opus-4-8

# LLM extraction of a long PDF can take minutes; keep the lease above the call
# budget so a live job is never re-leased mid-extraction.
QUANT_TIMEOUT=300s
JOB_LEASE_DURATION=10m
